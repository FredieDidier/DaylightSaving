% ── Daylight saving time, light and road safety ────────────────────────────

% Spring transition adds >30 deaths a year, 2002-2011, US; sleep; evening
% light mainly reallocates deaths within the day.
@article{smith2016spring,
  author  = {Smith, Austin C.},
  title   = {Spring Forward at Your Own Risk: Daylight Saving Time and Fatal Vehicle Crashes},
  journal = {American Economic Journal: Applied Economics},
  year    = {2016},
  volume  = {8},
  number  = {2},
  pages   = {65--91}
}

% Light from sunrise/sunset variation across space and time, Great Britain;
% darkness costs > GBP 500 million a year; year-round DST would save 8 percent.
@article{bunnings2021spring,
  author  = {B{\"u}nnings, Christian and Schiele, Valentin},
  title   = {Spring Forward, Don't Fall Back: The Effect of Daylight Saving Time on Road Safety},
